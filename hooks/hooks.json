{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "exec bash \"${CLAUDE_PLUGIN_ROOT}/skills/session-log/adapters/claude/claude_hook.sh\" session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec bash \"${CLAUDE_PLUGIN_ROOT}/skills/session-log/adapters/claude/claude_hook.sh\" user-prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec bash \"${CLAUDE_PLUGIN_ROOT}/skills/session-log/adapters/claude/claude_hook.sh\" stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec bash \"${CLAUDE_PLUGIN_ROOT}/skills/session-log/adapters/claude/claude_hook.sh\" subagent-stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
