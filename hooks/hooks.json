{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "s='${CLAUDE_PLUGIN_ROOT}/scripts/prompt_log_new_session.sh'; s=\"${s//\\\\//}\"; [ -f \"$s\" ] && exec bash \"$s\"; exit 0"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s='${CLAUDE_PLUGIN_ROOT}/scripts/prompt_log_save.sh'; s=\"${s//\\\\//}\"; [ -f \"$s\" ] && exec bash \"$s\"; exit 0"
          }
        ]
      }
    ]
  }
}
