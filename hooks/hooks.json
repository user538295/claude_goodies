{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_PLUGIN_ROOT}/skills/session-log/scripts/prompt_log_new_session.sh\"; s=\"${s//\\\\//}\"; [ -f \"$s\" ] && exec bash \"$s\"; exit 0"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_PLUGIN_ROOT}/skills/session-log/scripts/prompt_log_save.sh\"; s=\"${s//\\\\//}\"; [ -f \"$s\" ] && exec bash \"$s\"; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_PLUGIN_ROOT}/skills/session-log/scripts/prompt_log_stop.sh\"; s=\"${s//\\\\//}\"; [ -f \"$s\" ] && exec bash \"$s\"; exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_PLUGIN_ROOT}/skills/session-log/scripts/prompt_log_subagent.sh\"; s=\"${s//\\\\//}\"; [ -f \"$s\" ] && exec bash \"$s\"; exit 0",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
