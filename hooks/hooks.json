{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"${CLAUDE_PLUGIN_ROOT:-$HOME/.claude}/scripts/prompt_log_new_session.sh\"; [ -f \"$SCRIPT\" ] && bash \"$SCRIPT\" || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"${CLAUDE_PLUGIN_ROOT:-$HOME/.claude}/scripts/prompt_log_save.sh\"; [ -f \"$SCRIPT\" ] && bash \"$SCRIPT\" || true"
          }
        ]
      }
    ]
  }
}
